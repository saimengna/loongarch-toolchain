stamps/build-gcc-musl-stage1: $(GCC_SRCDIR) $(GCC_SRC_GIT) stamps/build-binutils-musl \
                               stamps/build-linux-headers
	if test -f $</contrib/download_prerequisites && test "@NEED_GCC_EXTERNAL_LIBRARIES@" = "true"; then cd $< && ./contrib/download_prerequisites; fi
	rm -rf $@ $(notdir $@)
	mkdir $(notdir $@)
	cd $(notdir $@) && $</configure \
		--target=$(MUSL_TUPLE) \
		$(CONFIGURE_HOST) \
		--prefix=$(INSTALL_DIR) \
		--without-headers \
		--disable-shared \
		--disable-threads \
		@with_system_zlib@ \
		--enable-tls \
		--enable-languages=c \
		--disable-libatomic \
		--disable-libmudflap \
		--disable-libssp \
		--disable-libquadmath \
		--disable-libgomp \
		--disable-nls \
		--disable-bootstrap \
		--src=$(gccsrcdir) \
		$(ENABLE_DEFAULT_PIE) \
		$(GCC_CHECKING_FLAGS) \
		--disable-multilib \
		$(WITH_ABI) \
		$(WITH_ARCH) \
		$(WITH_TUNE) \
		$(WITH_CPU) \
		$(WITH_MUL_FDIV) \
		$(GCC_EXTRA_CONFIGURE_FLAGS) \
		CFLAGS_FOR_TARGET="-O2 $(CFLAGS_FOR_TARGET)" \
		CXXFLAGS_FOR_TARGET="-O2 $(CXXFLAGS_FOR_TARGET)"
	$(MAKE) -C $(notdir $@) inhibit-libc=true all-gcc
	$(MAKE) -C $(notdir $@) inhibit-libc=true $(INSTALL_TARGET)-gcc
	$(MAKE) -C $(notdir $@) inhibit-libc=true all-target-libgcc
	$(MAKE) -C $(notdir $@) inhibit-libc=true install-target-libgcc
	mkdir -p $(dir $@) && touch $@

stamps/build-musl-linux: $(MUSL_SRCDIR) $(MUSL_SRC_GIT) stamps/build-gcc-musl-stage1
	rm -rf $@ $(notdir $@)
	mkdir $(notdir $@)
	cd $(notdir $@) && \
		CC="$(MUSL_CC_FOR_TARGET)" \
		CXX="$(MUSL_CXX_FOR_TARGET)" \
		CFLAGS="$(CFLAGS_FOR_TARGET) -O2" \
		CXXFLAGS="$(CXXFLAGS_FOR_TARGET) -O2" \
		ASFLAGS="$(ASFLAGS_FOR_TARGET)" \
		$</configure \
		--host=$(MUSL_TUPLE) \
		--prefix=$(SYSROOT) \
		--syslibdir=$(SYSROOT)/lib \
		--disable-werror \
		--enable-shared \
		$(MUSL_TARGET_FLAGS)
	$(MAKE) -C $(notdir $@)
	mkdir -p $(SYSROOT)
	+flock $(SYSROOT)/.lock $(MAKE) -C $(notdir $@) install
	for ldso in $(SYSROOT)/lib/ld-musl-*.so.1; do \
		if [ -L "$$ldso" ]; then \
			ln -sfn "$$(basename "$$(readlink "$$ldso")")" "$$ldso"; \
		fi; \
	done
	mkdir -p $(dir $@) && touch $@

stamps/build-gcc-musl-stage2: ENABLED_LANGUAGES?="c,c++"
stamps/build-gcc-musl-stage2: $(GCC_SRCDIR) $(GCC_SRC_GIT) stamps/build-musl-linux
	rm -rf $@ $(notdir $@)
	mkdir $(notdir $@)
	cd $(notdir $@) && $</configure \
		--target=$(MUSL_TUPLE) \
		$(CONFIGURE_HOST) \
		--prefix=$(INSTALL_DIR) \
		--with-sysroot=$(SYSROOT) \
		--with-native-system-header-dir=/include \
		@with_system_zlib@ \
		--enable-shared \
		--enable-tls \
		--enable-languages=$(ENABLED_LANGUAGES) \
		--disable-libmudflap \
		--disable-libssp \
		--disable-libquadmath \
		--disable-libsanitizer \
		--disable-nls \
		--disable-bootstrap \
		--src=$(gccsrcdir) \
		$(ENABLE_DEFAULT_PIE) \
		$(GCC_CHECKING_FLAGS) \
		--disable-multilib \
		$(WITH_ABI) \
		$(WITH_ARCH) \
		$(WITH_TUNE) \
		$(WITH_CPU) \
		$(WITH_MUL_FDIV) \
		$(GCC_WITH_SPECS) \
		$(GCC_EXTRA_CONFIGURE_FLAGS) \
		CFLAGS_FOR_TARGET="-O2 $(CFLAGS_FOR_TARGET)" \
		CXXFLAGS_FOR_TARGET="-O2 $(CXXFLAGS_FOR_TARGET)"
	$(MAKE) -C $(notdir $@)
	$(MAKE) -C $(notdir $@) $(INSTALL_TARGET)
	cp -a $(INSTALL_DIR)/$(MUSL_TUPLE)/lib* $(SYSROOT)
	mkdir -p $(dir $@) && touch $@

#
# QEMU
#

stamps/build-qemu: $(QEMU_SRCDIR) $(QEMU_SRC_GIT) $(PREPARATION_STAMP)
	rm -rf $@ $(notdir $@)
	mkdir $(notdir $@)
	cd $(notdir $@) && $</configure \
		--prefix=$(INSTALL_DIR) \
		--target-list=$(QEMU_TARGETS) \
		--interp-prefix=$(INSTALL_DIR)/sysroot \
		$(QEMU_EXTRA_CONFIGURE_FLAGS) \
		--python=$(QEMU_PYTHON)
	$(MAKE) -C $(notdir $@)
	$(MAKE) -C $(notdir $@) install
	mkdir -p $(dir $@)
	date > $@

#
# LLVM
#

stamps/build-llvm-linux: $(LLVM_SRCDIR) $(LLVM_SRC_GIT) $(BINUTILS_SRCDIR) $(BINUTILS_SRC_GIT) \
                         stamps/build-gcc-linux-stage2
	$(LLVM_LINUX_SYSROOT_SETUP)
	cd $(notdir $@) && \
	    cmake $(LLVM_SRCDIR)/llvm \
	    $(LLVM_LINUX_COMMON_CMAKE_FLAGS) \
	    -DLLVM_DEFAULT_TARGET_TRIPLE=$(LINUX_TUPLE) \
	    -DLLVM_RUNTIME_TARGETS=$(LINUX_TUPLE) \
	    "-DRUNTIMES_$(LINUX_TUPLE)_CMAKE_C_FLAGS=$(LLVM_CFLAGS_FOR_TARGET)" \
	    "-DRUNTIMES_$(LINUX_TUPLE)_CMAKE_CXX_FLAGS=$(LLVM_CXXFLAGS_FOR_TARGET)" \
	    -DRUNTIMES_$(LINUX_TUPLE)_FLANG_RT_INCLUDE_TESTS=OFF \
	    $(LLVM_EXTRA_CONFIGURE_FLAGS)
	+$(LLVM_BUILD_TOOL) $(notdir $@)
	+$(LLVM_BUILD_TOOL) $(notdir $@) $(subst -,/,$(INSTALL_TARGET))
	cp $(notdir $@)/lib/$(LINUX_TUPLE)/libc++* $(SYSROOT)/lib
	cp $(notdir $@)/lib/$(LINUX_TUPLE)/libunwind* $(SYSROOT)/lib
	cd $(INSTALL_DIR)/bin && ln -s -f clang $(LINUX_TUPLE)-clang && ln -s -f clang++ $(LINUX_TUPLE)-clang++
	mkdir -p $(dir $@) && touch $@

stamps/build-llvm-musl: $(LLVM_SRCDIR) $(LLVM_SRC_GIT) $(BINUTILS_SRCDIR) $(BINUTILS_SRC_GIT) \
                         stamps/build-gcc-musl-stage2
	$(LLVM_LINUX_SYSROOT_SETUP)
	cd $(notdir $@) && \
	    cmake $(LLVM_SRCDIR)/llvm \
	    $(LLVM_LINUX_COMMON_CMAKE_FLAGS) \
	    -DLLVM_DEFAULT_TARGET_TRIPLE=$(MUSL_TUPLE) \
	    -DLLVM_RUNTIME_TARGETS=$(MUSL_TUPLE) \
	    -DRUNTIMES_$(MUSL_TUPLE)_LIBCXX_HAS_MUSL_LIBC=On \
	    -DRUNTIMES_$(MUSL_TUPLE)_COMPILER_RT_BUILD_SANITIZERS=Off \
	    -DRUNTIMES_$(MUSL_TUPLE)_COMPILER_RT_BUILD_XRAY=Off \
	    -DRUNTIMES_$(MUSL_TUPLE)_COMPILER_RT_BUILD_ORC=Off \
	    "-DRUNTIMES_$(MUSL_TUPLE)_CMAKE_C_FLAGS=$(LLVM_CFLAGS_FOR_TARGET)" \
	    "-DRUNTIMES_$(MUSL_TUPLE)_CMAKE_CXX_FLAGS=$(LLVM_CXXFLAGS_FOR_TARGET)" \
	    -DRUNTIMES_$(MUSL_TUPLE)_FLANG_RT_INCLUDE_TESTS=OFF \
	    $(LLVM_EXTRA_CONFIGURE_FLAGS)
	+$(LLVM_BUILD_TOOL) $(notdir $@)
	+$(LLVM_BUILD_TOOL) $(notdir $@) $(subst -,/,$(INSTALL_TARGET))
	cp $(notdir $@)/lib/$(MUSL_TUPLE)/libc++* $(SYSROOT)/lib
	cp $(notdir $@)/lib/$(MUSL_TUPLE)/libunwind* $(SYSROOT)/lib
	cd $(INSTALL_DIR)/bin && ln -s -f clang $(MUSL_TUPLE)-clang && ln -s -f clang++ $(MUSL_TUPLE)-clang++
	mkdir -p $(dir $@) && touch $@

stamps/build-llvm-newlib: $(LLVM_SRCDIR) $(LLVM_SRC_GIT) $(BINUTILS_SRCDIR) $(BINUTILS_SRC_GIT) \
                          stamps/build-gcc-newlib-stage2
	rm -rf $@ $(notdir $@)
	mkdir $(notdir $@)
	cd $(notdir $@) && \
	    cmake $(LLVM_SRCDIR)/llvm \
	    -G "$(LLVM_GENERATOR)" \
	    -DCMAKE_INSTALL_PREFIX=$(INSTALL_DIR) \
	    -DCMAKE_BUILD_TYPE=Release \
	    -DLLVM_TARGETS_TO_BUILD="LoongArch" \
	    -DLLVM_ENABLE_PROJECTS="llvm;clang;lld" \
	    -DLLVM_DEFAULT_TARGET_TRIPLE="$(NEWLIB_TUPLE)" \
	    -DLLVM_INSTALL_TOOLCHAIN_ONLY=On \
	    -DLLVM_BINUTILS_INCDIR=$(BINUTILS_SRCDIR)/include \
	    -DLLVM_PARALLEL_LINK_JOBS=4 \
	    $(LLVM_COMMON_CMAKE_FLAGS) \
	    $(LLVM_EXTRA_CONFIGURE_FLAGS)
	+$(LLVM_BUILD_TOOL) $(notdir $@)
	+$(LLVM_BUILD_TOOL) $(notdir $@) $(subst -,/,$(INSTALL_TARGET))
	cd $(INSTALL_DIR)/bin && ln -s -f clang $(NEWLIB_TUPLE)-clang && \
	    ln -s -f clang++ $(NEWLIB_TUPLE)-clang++
	mkdir -p $(dir $@) && touch $@

#
# Tests
#

REGRESSION_TEST_LIST = gcc
REPORT_STRICT ?= 0
REPORT_SUMMARY_FLAGS := $(if $(filter 1 yes true,$(REPORT_STRICT)),--strict)

# Overridable so the Tier 2 P0 run can narrow the testsuites (C-only GCC,
# LoongArch-only binutils) without weakening the default `make check`.
GCC_CHECK_TARGET ?= check-gcc
BINUTILS_CHECK_TARGETS ?= check-binutils check-gas check-ld

.PHONY: check check-linux check-newlib check-newlib-nano check-musl
check: check-@default_target@
check-linux: $(patsubst %,check-%-linux,$(REGRESSION_TEST_LIST))
check-newlib: $(patsubst %,check-%-newlib,$(REGRESSION_TEST_LIST))
check-newlib-nano: $(patsubst %,check-%-newlib-nano,$(REGRESSION_TEST_LIST))
check-musl: $(patsubst %,check-%-musl,$(REGRESSION_TEST_LIST))

.PHONY: check-gcc check-gcc-linux check-gcc-newlib check-gcc-newlib-nano check-gcc-musl
check-gcc: check-gcc-@default_target@
check-gcc-linux: stamps/check-gcc-linux
check-gcc-newlib: stamps/check-gcc-newlib
check-gcc-newlib-nano: stamps/check-gcc-newlib-nano
check-gcc-musl: stamps/check-gcc-musl

.PHONY: check-binutils check-binutils-linux check-binutils-newlib check-binutils-newlib-nano
check-binutils: check-binutils-@default_target@
check-binutils-linux: stamps/check-binutils-linux
check-binutils-newlib: stamps/check-binutils-newlib
check-binutils-newlib-nano: stamps/check-binutils-newlib-nano

.PHONY: check-gdb check-gdb-linux check-gdb-newlib check-gdb-newlib-nano
check-gdb: check-gdb-@default_target@
check-gdb-linux: stamps/check-gdb-linux
check-gdb-newlib: stamps/check-gdb-newlib
check-gdb-newlib-nano: stamps/check-gdb-newlib-nano

.PHONY: check-glibc check-glibc-linux
check-glibc: check-glibc-linux
check-glibc-linux: $(addprefix stamps/check-glibc-linux-,$(GLIBC_MULTILIB_NAMES))

.PHONY: report report-linux report-newlib report-newlib-nano report-musl
report: report-@default_target@
report-linux: $(patsubst %,report-%-linux,$(REGRESSION_TEST_LIST))
report-newlib: $(patsubst %,report-%-newlib,$(REGRESSION_TEST_LIST))
report-newlib-nano: $(patsubst %,report-%-newlib-nano,$(REGRESSION_TEST_LIST))
report-musl: $(patsubst %,report-%-musl,$(REGRESSION_TEST_LIST))

.PHONY: report-gcc report-binutils report-gdb
report-gcc: report-gcc-@default_target@
report-binutils: report-binutils-@default_target@
report-gdb: report-gdb-@default_target@

.PHONY: report-gcc-linux report-gcc-newlib report-gcc-newlib-nano report-gcc-musl
report-gcc-linux: stamps/check-gcc-linux
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gcc/linux" build-gcc-linux-stage2/gcc/testsuite
report-gcc-newlib: stamps/check-gcc-newlib
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gcc/newlib" build-gcc-newlib-stage2/gcc/testsuite
report-gcc-newlib-nano: stamps/check-gcc-newlib-nano
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gcc/newlib-nano" build-gcc-newlib-stage2/gcc/testsuite
report-gcc-musl: stamps/check-gcc-musl
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gcc/musl" build-gcc-musl-stage2/gcc/testsuite

.PHONY: report-binutils-linux report-binutils-newlib report-binutils-newlib-nano
report-binutils-linux: stamps/check-binutils-linux
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "binutils/linux" build-binutils-linux
report-binutils-newlib: stamps/check-binutils-newlib
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "binutils/newlib" build-binutils-newlib
report-binutils-newlib-nano: stamps/check-binutils-newlib-nano
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "binutils/newlib-nano" build-binutils-newlib

.PHONY: report-gdb-linux report-gdb-newlib report-gdb-newlib-nano
report-gdb-linux: stamps/check-gdb-linux
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gdb/linux" build-gdb-linux
report-gdb-newlib: stamps/check-gdb-newlib
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gdb/newlib" build-gdb-newlib
report-gdb-newlib-nano: stamps/check-gdb-newlib-nano
	$(srcdir)/scripts/testsuite-summary $(REPORT_SUMMARY_FLAGS) --label "gdb/newlib-nano" build-gdb-newlib

stamps/check-gcc-linux: stamps/build-gcc-linux-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gcc-linux-stage2 $(GCC_CHECK_TARGET) "RUNTESTFLAGS=$(RUNTESTFLAGS) --target_board='$(GLIBC_TARGET_BOARDS)'"
	mkdir -p $(dir $@)
	date > $@

stamps/check-gcc-newlib: stamps/build-gcc-newlib-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gcc-newlib-stage2 $(GCC_CHECK_TARGET) "RUNTESTFLAGS=$(RUNTESTFLAGS) --target_board='$(NEWLIB_TARGET_BOARDS)'"
	mkdir -p $(dir $@)
	date > $@

stamps/check-gcc-newlib-nano: stamps/build-gcc-newlib-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gcc-newlib-stage2 $(GCC_CHECK_TARGET) "RUNTESTFLAGS=$(RUNTESTFLAGS) --target_board='$(NEWLIB_NANO_TARGET_BOARDS)'"
	mkdir -p $(dir $@)
	date > $@

stamps/check-gcc-musl: stamps/build-gcc-musl-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gcc-musl-stage2 $(GCC_CHECK_TARGET) "RUNTESTFLAGS=$(RUNTESTFLAGS) --target_board='loongarch-sim/-march=$(LLVM_TARGET_ARCH)/-mabi=$(LLVM_TARGET_ABI)/-mcmodel=$(shell echo @cmodel@ | cut -d '=' -f2)'"
	mkdir -p $(dir $@)
	date > $@

stamps/check-binutils-linux: stamps/build-gcc-linux-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-binutils-linux $(BINUTILS_CHECK_TARGETS) -k "RUNTESTFLAGS=--target_board='$(GLIBC_TARGET_BOARDS)'" || true
	date > $@

stamps/check-binutils-newlib: stamps/build-gcc-newlib-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-binutils-newlib $(BINUTILS_CHECK_TARGETS) -k "RUNTESTFLAGS=--target_board='$(NEWLIB_TARGET_BOARDS)'" || true
	date > $@

stamps/check-binutils-newlib-nano: stamps/build-gcc-newlib-stage2 $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-binutils-newlib $(BINUTILS_CHECK_TARGETS) -k "RUNTESTFLAGS=--target_board='$(NEWLIB_NANO_TARGET_BOARDS)'" || true
	date > $@

stamps/check-gdb-linux: stamps/build-gcc-linux-stage2 stamps/build-gdb-linux $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gdb-linux check-gdb -k "RUNTESTFLAGS=--target_board='$(GLIBC_TARGET_BOARDS)'" || true
	date > $@

stamps/check-gdb-newlib: stamps/build-gcc-newlib-stage2 stamps/build-gdb-newlib $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gdb-newlib check-gdb -k "RUNTESTFLAGS=--target_board='$(NEWLIB_TARGET_BOARDS)'" || true
	date > $@

stamps/check-gdb-newlib-nano: stamps/build-gcc-newlib-stage2 stamps/build-gdb-newlib $(SIM_STAMP)
	$(SIM_PREPARE) DEJAGNU="$(srcdir)/scripts/site.exp" $(MAKE) -C build-gdb-newlib check-gdb -k "RUNTESTFLAGS=--target_board='$(NEWLIB_NANO_TARGET_BOARDS)'" || true
	date > $@

stamps/check-glibc-linux-%: stamps/build-gcc-linux-stage2 $(SIM_STAMP) \
		$(addprefix stamps/build-glibc-linux-,$(GLIBC_MULTILIB_NAMES))
	$(eval $@_BUILD_DIR := $(subst check-,build-,$(notdir $@)))
	$(SIM_PREPARE) $(MAKE) -C $($@_BUILD_DIR) check
	mkdir -p $(dir $@)
	date > $@

clean:
	rm -rf build-* install-* stamps

distclean: clean

# All of the packages install themselves, so our install target does nothing.
install:

# Rebuilding Makefile.
Makefile: $(srcdir)/Makefile.in config.status
	CONFIG_FILES=$@ CONFIG_HEADERS= $(SHELL) ./config.status

config.status: $(srcdir)/configure
	CONFIG_SHELL="$(SHELL)" $(SHELL) ./config.status --recheck
