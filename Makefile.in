		--prefix=$(INSTALL_DIR) \
		--enable-plugins \
		@with_guile@ \
		--disable-werror \
		$(BINUTILS_TARGET_FLAGS) \
		--disable-gdb \
		--disable-sim \
		--disable-libdecnumber \
		--disable-readline \
		$(WITH_ABI) \
		$(WITH_ARCH)
	$(MAKE) -C $(notdir $@)
	$(MAKE) -C $(notdir $@) $(INSTALL_TARGET)
	mkdir -p $(dir $@) && touch $@

stamps/build-gdb-newlib: $(GDB_SRCDIR) $(GDB_SRC_GIT) $(PREPARATION_STAMP)
