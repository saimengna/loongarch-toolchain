#!/usr/bin/env python3
"""Summarize DejaGNU .sum files and optionally fail on unexpected results."""

import argparse
import collections
import os
import sys

COUNTED = ("PASS", "FAIL", "XPASS", "XFAIL", "UNRESOLVED", "UNSUPPORTED", "ERROR")
UNEXPECTED = ("FAIL", "XPASS", "UNRESOLVED", "ERROR")


def find_sum_files(paths):
    for path in paths:
        if os.path.isfile(path) and path.endswith(".sum"):
            yield path
            continue
        for root, _, files in os.walk(path):
            for name in sorted(files):
                if name.endswith(".sum"):
                    yield os.path.join(root, name)


def read_counts(path, totals, failures):
    counts = collections.Counter()
    with open(path, encoding="utf-8", errors="replace") as stream:
        for line in stream:
            status = line.split(None, 1)[0].rstrip(":") if line.strip() else ""
            if status in COUNTED:
                counts[status] += 1
                totals[status] += 1
                if status in UNEXPECTED:
                    failures.append(line.rstrip())
    return counts


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--label", required=True)
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--baseline", help="file containing reviewed expected failures")
    parser.add_argument("--update-baseline", action="store_true")
    parser.add_argument("paths", nargs="+")
    args = parser.parse_args()

    if args.update_baseline and not args.baseline:
        parser.error("--update-baseline requires --baseline")

    totals = collections.Counter()
    failures = []
    seen = 0
    print(f"=== {args.label} ===")
    for path in find_sum_files(args.paths):
        counts = read_counts(path, totals, failures)
        seen += 1
        print(
            f"{path}: PASS={counts['PASS']} FAIL={counts['FAIL']} "
            f"XPASS={counts['XPASS']} XFAIL={counts['XFAIL']} "
            f"UNRESOLVED={counts['UNRESOLVED']} UNSUPPORTED={counts['UNSUPPORTED']}"
        )

    if seen == 0:
        print(f"no .sum files found under: {' '.join(args.paths)}")
        return 1

    print(
        "TOTAL: "
        + " ".join(f"{key}={totals[key]}" for key in COUNTED if totals[key])
    )
    baseline = set()
    if args.baseline:
        if os.path.exists(args.baseline):
            with open(args.baseline, encoding="utf-8") as stream:
                baseline = {
                    line.strip()
                    for line in stream
                    if line.strip() and not line.lstrip().startswith("#")
                }
        elif not args.update_baseline:
            print(f"baseline not found: {args.baseline}")
            return 1

    new_failures = [failure for failure in failures if failure not in baseline]

    if args.update_baseline:
        os.makedirs(os.path.dirname(args.baseline) or ".", exist_ok=True)
        with open(args.baseline, "w", encoding="utf-8") as stream:
            stream.write("# Known expected failures; add reviewed lines as needed.\n")
            for failure in sorted(set(failures)):
                stream.write(failure + "\n")
        print(f"baseline updated: {args.baseline} ({len(set(failures))} entries)")
        return 0

    if failures:
        print(f"unexpected results: {len(failures)}")
        if baseline:
            print(f"known baseline entries: {len(baseline)}")
        print(f"new failures: {len(new_failures)}")
        for failure in new_failures[:200]:
            print(failure)
        if len(new_failures) > 200:
            print(f"... {len(new_failures) - 200} more")

    if args.strict:
        return 1 if new_failures else 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
